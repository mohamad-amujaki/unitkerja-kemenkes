---
import "../styles/global.css";
import metadata from "../data/metadata.json";
import units from "../data/units.json";

const updatedDate = new Date(metadata.generatedAt).toLocaleDateString("id-ID", {
	dateStyle: "long",
});
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Peta Persebaran Unit Kerja Kemenkes</title>
    <meta
      name="description"
      content="Visualisasi publik persebaran 222 unit kerja Kemenkes per provinsi dengan filter, tabel detail, dan ekspor CSV/Excel."
    />
  </head>
  <body>
    <div class="sticky top-0 z-30 border-b border-amber-200 bg-amber-50/95 backdrop-blur">
      <p class="mx-auto max-w-7xl px-4 py-2 text-xs text-amber-900 sm:px-6 lg:px-8">
        Disclaimer: Web app ini bukan produk resmi pemerintah dan tidak terafiliasi dengan Kementerian Kesehatan RI.
      </p>
    </div>
    <main class="mx-auto max-w-7xl px-4 pb-10 pt-6 sm:px-6 lg:px-8">
      <header class="mb-7 rounded-2xl border border-(--line) bg-(--surface) p-5 shadow-[0_12px_30px_-24px_rgba(14,79,63,0.8)] sm:p-7" data-animate>
        <p class="mb-2 inline-flex rounded-full border border-(--line) bg-(--surface-soft) px-3 py-1 text-xs font-semibold tracking-wide text-(--brand-1)">
          Proyek Independen
        </p>
        <h1 class="text-2xl font-semibold tracking-tight text-(--ink) sm:text-4xl">
          Peta Persebaran Unit Kerja Kemenkes
        </h1>
        <p class="mt-3 max-w-6xl text-sm leading-relaxed text-(--ink-muted) sm:text-base">
          Proyek pribadi untuk memvisualisasi persebaran unit kerja Kemenkes secara publik. Aplikasi ini dikembangkan dengan bantuan AI (vibe coding), tidak mewakili instansi resmi, dan tidak digunakan sebagai rujukan administratif.
        </p>
        <div class="mt-4 grid gap-3 text-sm text-(--ink-muted) sm:grid-cols-3">
          <p><span class="font-semibold text-(--ink)">Sumber:</span> `docs/data_upt_kemenkes.xlsx`</p>
          <p><span class="font-semibold text-(--ink)">Update data:</span> {updatedDate}</p>
          <p><span class="font-semibold text-(--ink)">Perbaikan data:</span> WhatsApp</p>
        </div>
      </header>

      <section class="mb-6" data-animate>
        <article id="metodologi" class="rounded-2xl border border-amber-200 bg-amber-50 p-4">
          <h2 class="text-sm font-semibold text-amber-900">Baca Sebelum Menggunakan Data</h2>
          <p class="mt-2 text-sm leading-relaxed text-amber-900/90">
            Data ditampilkan untuk kebutuhan visualisasi publik dan pembelajaran. Bisa ada keterlambatan pembaruan atau kekurangan verifikasi sumber.
          </p>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-xs text-amber-900/90">
            <li>Bukan kanal resmi pemerintah</li>
            <li>Bukan dokumen keputusan administratif</li>
            <li>Koreksi data dikirim ke maintainer pribadi</li>
          </ul>
          <h3 class="mt-4 text-sm font-semibold text-amber-900">Metodologi Singkat</h3>
          <p class="mt-2 text-sm text-amber-900/90">Sumber data diolah dari workbook, ditransformasi ke JSON, lalu divalidasi otomatis sebelum build.</p>
          <p class="mt-3 text-xs text-amber-900/80">Detail teknis lengkap tersedia pada README dan PRD di repositori proyek.</p>
        </article>
      </section>

      <section class="mb-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-4" data-animate>
        <article class="rounded-2xl border border-(--line) bg-(--surface) p-4">
          <p class="text-xs uppercase tracking-wide text-(--ink-muted)">Total Unit</p>
          <p id="stat-total-unit" class="mt-1 text-3xl font-semibold text-(--brand-1)">0</p>
        </article>
        <article class="rounded-2xl border border-(--line) bg-(--surface) p-4">
          <p class="text-xs uppercase tracking-wide text-(--ink-muted)">Provinsi Terliput</p>
          <p id="stat-total-provinsi" class="mt-1 text-3xl font-semibold text-(--brand-1)">0</p>
        </article>
        <article class="rounded-2xl border border-(--line) bg-(--surface) p-4">
          <p class="text-xs uppercase tracking-wide text-(--ink-muted)">Eselon I</p>
          <p id="stat-total-eselon" class="mt-1 text-3xl font-semibold text-(--brand-1)">0</p>
        </article>
        <article class="rounded-2xl border border-(--line) bg-(--surface) p-4">
          <p class="text-xs uppercase tracking-wide text-(--ink-muted)">Alamat Unik</p>
          <p id="stat-total-alamat" class="mt-1 text-3xl font-semibold text-(--brand-1)">0</p>
        </article>
      </section>

      <section class="mb-6 grid gap-4 xl:grid-cols-[1.75fr_0.75fr]" data-animate>
        <article class="rounded-2xl border border-(--line) bg-(--surface) p-3 sm:p-4">
          <div class="mb-3 flex items-center justify-between gap-2">
            <h2 class="text-lg font-semibold text-(--ink)">Filled Map Unit Kerja per Provinsi</h2>
            <p id="map-result-count" class="rounded-full border border-(--line) bg-(--surface-soft) px-3 py-1 text-xs text-(--ink-muted)">0 hasil</p>
          </div>
          <div id="map" role="img" aria-label="Peta persebaran unit kerja Kemenkes per provinsi"></div>
        </article>
        <article class="rounded-2xl border border-(--line) bg-(--surface) p-4">
          <h2 class="mb-2 text-base font-semibold text-(--ink)">Keterangan & Koreksi</h2>
          <ul id="legend-list" class="space-y-1.5 text-xs text-(--ink-muted)"></ul>
          <div class="mt-4 rounded-xl border border-(--line) bg-white p-3">
            <p class="text-xs leading-relaxed text-(--ink-muted)">Temukan data kurang tepat? Kirim koreksi lewat WhatsApp, lalu kami verifikasi sebelum update berikutnya.</p>
            <a class="mt-3 inline-flex w-full items-center justify-center rounded-lg border border-(--brand-2) bg-(--brand-2) px-3 py-2 text-xs font-semibold text-white transition hover:bg-(--brand-1)" href="https://wa.me/6281315866766" target="_blank" rel="noreferrer noopener">Kirim Koreksi via WhatsApp</a>
          </div>
        </article>
      </section>

      <div id="toolbar-sticky-trigger" class="h-px" aria-hidden="true"></div>

      <section class="mb-6" data-animate>
        <div id="filter-toolbar" class="sticky top-2 z-20 rounded-2xl border border-(--line) bg-(--surface) p-3 shadow-[0_10px_30px_-28px_rgba(17,35,26,0.8)] transition-[box-shadow] duration-200" style="position: static;">
          <div class="grid items-center gap-2 sm:grid-cols-2 lg:grid-cols-[1.2fr_auto_auto_auto_auto]">
            <label class="block">
              <span class="sr-only">Cari unit kerja</span>
              <input id="search-filter" type="search" placeholder="Cari unit kerja, alamat, atau provinsi" class="w-full rounded-lg border border-(--line) bg-white px-3 py-2 text-sm text-(--ink)" />
            </label>
            <select id="province-filter" class="rounded-lg border border-(--line) bg-white px-3 py-2 text-sm text-(--ink)">
            </select>
            <select id="eselon-filter" class="rounded-lg border border-(--line) bg-white px-3 py-2 text-sm text-(--ink)">
            </select>
            <details id="export-menu" class="relative">
              <summary class="cursor-pointer list-none rounded-lg border border-(--line) bg-white px-3 py-2 text-sm font-semibold text-(--ink) marker:hidden">Ekspor</summary>
              <div class="absolute right-0 top-11 w-40 rounded-lg border border-(--line) bg-white p-1 shadow-lg">
                <button id="export-csv" type="button" class="block w-full rounded-md px-3 py-2 text-left text-sm text-(--ink-muted) transition hover:bg-(--surface-soft)">CSV</button>
                <button id="export-xlsx" type="button" class="block w-full rounded-md px-3 py-2 text-left text-sm text-(--ink-muted) transition hover:bg-(--surface-soft)">Excel (.xlsx)</button>
              </div>
            </details>
            <button id="reset-filter" type="button" class="rounded-lg border border-transparent px-2 py-2 text-sm text-(--ink-muted) underline underline-offset-2 transition hover:text-(--ink)">Reset</button>
          </div>
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <p id="active-filters" class="text-xs text-(--ink-muted)"></p>
            <p id="result-count" class="rounded-full border border-(--line) bg-(--surface-soft) px-2 py-0.5 text-xs text-(--ink-muted)">0 hasil</p>
          </div>
          <p id="map-note" class="mt-2 text-xs leading-relaxed text-(--warn)">
            Catatan: beberapa provinsi hasil pemekaran Papua masih berbagi geometri peta pada dataset boundary saat ini.
          </p>
        </div>
      </section>

      <section class="rounded-2xl border border-(--line) bg-(--surface) p-4 sm:p-5" data-animate>
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <h2 class="text-lg font-semibold text-(--ink)">Daftar Unit Kerja</h2>
          <span id="verification-summary" class="rounded-full border border-(--line) px-3 py-1 text-xs text-(--ink-muted)"></span>
        </div>
        <p class="mb-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900">
          Data tabel untuk visualisasi publik (non-resmi). Untuk rujukan formal, gunakan kanal resmi instansi terkait.
        </p>

        <div class="mb-3 grid gap-2 sm:grid-cols-[1fr_auto_auto]">
          <label class="relative block">
            <span class="sr-only">Cari di tabel unit kerja</span>
            <input id="table-search" type="search" placeholder="Cari cepat di tabel unit kerja" class="w-full rounded-xl border border-(--line) bg-white px-3 py-2 pr-20 text-sm text-(--ink)" />
            <button id="clear-table-search" type="button" class="absolute right-2 top-1/2 -translate-y-1/2 rounded-md border border-(--line) px-2 py-1 text-xs text-(--ink-muted) transition hover:bg-(--surface-soft)">Reset</button>
          </label>
          <label class="inline-flex items-center gap-2 rounded-xl border border-(--line) bg-white px-3 py-2 text-sm text-(--ink-muted)">
            <span>Baris</span>
            <select id="page-size" class="rounded-md border border-(--line) bg-white px-2 py-1 text-(--ink)">
              <option value="10">10</option>
              <option value="20" selected>20</option>
              <option value="50">50</option>
            </select>
          </label>
          <p id="pagination-summary" class="inline-flex items-center justify-center rounded-xl border border-(--line) bg-(--surface-soft) px-3 py-2 text-sm text-(--ink-muted)"></p>
        </div>

        <div class="overflow-x-auto rounded-xl border border-(--line)">
          <table class="min-w-[700px] w-full border-collapse text-left text-sm">
            <thead class="bg-(--surface-soft) text-(--ink)">
              <tr>
                <th class="px-3 py-2">No</th>
                <th class="px-3 py-2">Unit Eselon I - Unit Kerja</th>
                <th class="px-3 py-2">Provinsi</th>
                <th class="px-3 py-2">Alamat</th>
                <th class="px-3 py-2">Aksi</th>
              </tr>
            </thead>
            <tbody id="units-table-body" class="bg-white"></tbody>
          </table>
        </div>

        <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
          <p id="pagination-hint" class="text-xs text-(--ink-muted)">Navigasi halaman tabel</p>
          <nav id="pagination-controls" class="flex flex-wrap items-center gap-1.5" aria-label="Pagination daftar unit kerja"></nav>
        </div>
      </section>

      <footer class="mt-6 rounded-2xl border border-(--line) bg-(--surface) p-4 text-xs text-(--ink-muted)" data-animate>
        <p class="font-semibold text-(--ink)">Disclaimer Legal</p>
        <p class="mt-1">Web app ini adalah project pribadi, bukan produk resmi pemerintah, dan tidak terafiliasi dengan Kementerian Kesehatan RI atau unit organisasinya.</p>
        <p class="mt-1">Dikembangkan dengan bantuan AI (vibe coding) untuk visualisasi data publik. Akurasi data diupayakan, namun dapat berubah.</p>
      </footer>
    </main>

    <div id="disclaimer-modal" class="fixed inset-0 z-40 hidden items-center justify-center bg-black/45 px-4" role="dialog" aria-modal="true" aria-labelledby="disclaimer-title">
      <div class="w-full max-w-lg rounded-2xl border border-(--line) bg-white p-5 shadow-2xl">
        <h2 id="disclaimer-title" class="text-lg font-semibold text-(--ink)">Sebelum lanjut</h2>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-(--ink-muted)">
          <li>Ini bukan situs resmi pemerintah dan tidak berafiliasi dengan Kemenkes.</li>
          <li>Data untuk visualisasi publik, bukan rujukan administratif formal.</li>
          <li>Project dikembangkan dengan bantuan AI (vibe coding).</li>
        </ul>
        <button id="disclaimer-accept" type="button" class="mt-4 inline-flex rounded-lg border border-(--brand-2) bg-(--brand-2) px-4 py-2 text-sm font-semibold text-white transition hover:bg-(--brand-1)">Saya paham, lanjutkan</button>
      </div>
    </div>

    <script id="units-data" type="application/json" is:inline set:html={JSON.stringify(units)}></script>
    <script
      id="metadata-data"
      type="application/json"
      is:inline
      set:html={JSON.stringify(metadata)}
    ></script>

    <script>
      import { initDashboard } from "../scripts/dashboard.js";
      const units = JSON.parse(document.getElementById("units-data")?.textContent || "[]");
      const metadata = JSON.parse(document.getElementById("metadata-data")?.textContent || "{}");
      initDashboard({ units, metadata });

      const modal = document.getElementById("disclaimer-modal");
      const acceptButton = document.getElementById("disclaimer-accept");
      const seenKey = "unitkerja-disclaimer-seen";

      let hasSeenDisclaimer = false;
      try {
        hasSeenDisclaimer = window.localStorage.getItem(seenKey) === "1";
      } catch {
        hasSeenDisclaimer = false;
      }

      if (modal && acceptButton && !hasSeenDisclaimer) {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
      }

      acceptButton?.addEventListener("click", () => {
        try {
          window.localStorage.setItem(seenKey, "1");
        } catch {
          // Abaikan jika browser memblokir localStorage.
        }
        modal?.classList.add("hidden");
        modal?.classList.remove("flex");
      });
    </script>
  </body>
</html>
